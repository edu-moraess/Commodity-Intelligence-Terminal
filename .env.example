# ==========================================================================
# Commodity Intelligence Terminal — Variáveis de Ambiente
# ==========================================================================
# Copie este arquivo para `.env` e preencha os valores.
#   cp .env.example .env
#
# O código sempre lê essas chaves via os.getenv("NOME") — nunca hardcoded.
# NUNCA commite o arquivo `.env` real (já está no .gitignore).
#
# Em produção (Streamlit Cloud / Render / Railway / HF Spaces), NÃO se usa
# este arquivo — as mesmas chaves vão no "Secrets"/"Environment Variables"
# do painel de cada plataforma (ver README, seção "Guia de Deploy").
# ==========================================================================


# --------------------------------------------------------------------------
# ✅ EM USO HOJE (v1.0) — GRATUITA
# --------------------------------------------------------------------------

# FRED (séries macro — DXY, Treasury, CPI, PPI, Industrial Production...)
# Cadastro gratuito e imediato: https://fred.stlouisfed.org/docs/api/api_key.html
# Sem esta chave, o terminal funciona igual — só mostra dados macro
# simulados (badge 🔸) em vez dos reais.
FRED_API_KEY=

# Yahoo Finance (preços de futuros/proxies) — via biblioteca `yfinance`,
# NÃO requer chave de API. Nada a preencher aqui.


# --------------------------------------------------------------------------
# 🟡 GRATUITAS, MAS AINDA NÃO INTEGRADAS AO CÓDIGO (roadmap curto prazo)
# --------------------------------------------------------------------------
# Só cadastrar quando for implementar o módulo correspondente em
# data/sources/ — ver README > Roadmap de Expansão.

# EIA (Energy Information Administration) — produção OPEP/EUA, estoques
# semanais, rig count. Cadastro gratuito: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# USDA NASS/QuickStats — produção agrícola, safras, estoques, exportações.
# Cadastro gratuito: https://quickstats.nass.usda.gov/api
USDA_NASS_API_KEY=

# Alpha Vantage — fonte alternativa/backup de preços (free tier limitado,
# ~25 chamadas/dia). Cadastro: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Nasdaq Data Link (ex-Quandl) — datasets diversos de commodities, alguns
# gratuitos. Cadastro: https://data.nasdaq.com/sign-up
NASDAQ_DATA_LINK_API_KEY=


# --------------------------------------------------------------------------
# 🔴 PAGAS / REQUEREM CONTRATO COMERCIAL (não cadastre até decidir contratar)
# --------------------------------------------------------------------------
# Essas normalmente não têm "self-signup" — é preciso falar com vendas do
# provedor. Deixe em branco até fechar contrato; o terminal continua
# funcionando com os proxies via Yahoo Finance enquanto isso (ver notas
# de cada ativo em config/settings.py).

# Trading Economics — PMI (ISM), Baltic Dry Index, indicadores macro
# adicionais sem série pública no FRED.
TRADING_ECONOMICS_API_KEY=

# S&P Global Platts (Commodity Insights) — preços spot de carvão e outros
# benchmarks físicos sem futuro líquido no Yahoo Finance.
SP_PLATTS_API_KEY=

# CME DataMine / ICE — curva de futuros multi-vencimento real (contango/
# backwardation), Open Interest oficial por contrato.
CME_DATAMINE_API_KEY=

# LME Select — cotações oficiais de Níquel e Zinco (hoje via proxy ETF).
LME_SELECT_API_KEY=

# Fastmarkets / Benchmark Mineral Intelligence — preço spot de Lítio e
# outros minerais críticos sem contrato futuro líquido.
FASTMARKETS_API_KEY=

# Refinitiv (LSEG) / Bloomberg — substituem Yahoo Finance por dados
# institucionais de referência, caso seu banco/empresa já tenha acesso.
REFINITIV_API_KEY=
BLOOMBERG_API_KEY=


# --------------------------------------------------------------------------
# ⚙️ CONFIGURAÇÃO GERAL DA APLICAÇÃO
# --------------------------------------------------------------------------

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Taxa livre de risco anual usada em Sharpe/Sortino/Calmar (decimal)
RISK_FREE_RATE_ANNUAL=0.045
