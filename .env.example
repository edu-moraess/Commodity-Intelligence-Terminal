# Commodity Intelligence Terminal — Variáveis de Ambiente
# Copie este arquivo para `.env` e preencha os valores.

# FRED (séries macro — DXY, Treasury, CPI, PPI...)
# Chave gratuita em: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Taxa livre de risco anual usada em Sharpe/Sortino/Calmar (formato decimal)
RISK_FREE_RATE_ANNUAL=0.045

# --- Opcionais para expansão futura (ver README) ---
# EIA_API_KEY=
# USDA_NASS_API_KEY=
# ALPHAVANTAGE_API_KEY=
# TRADING_ECONOMICS_API_KEY=
# NASDAQ_DATA_LINK_API_KEY=